---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
}
const { eyebrow, title, subtitle } = Astro.props;
---
<section class="phero">
  <div class="wrap">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    {subtitle && <p>{subtitle}</p>}
  </div>
</section>

<style>
  .phero{
    background:radial-gradient(120% 140% at 80% -10%,var(--green-700),var(--green-900) 62%);
    color:#f3ecdc;text-align:center;padding:84px 0 74px;
  }
  .phero h1{font-size:clamp(2.3rem,4.6vw,3.6rem);color:#fbf6ea;margin:16px 0 14px}
  .phero p{color:#d6cfbe;max-width:56ch;margin:0 auto;font-size:1.05rem}
</style>
