---
interface Props {
  author: string;
  context: string;
  quote: string;
}
const { author, context, quote } = Astro.props;
const initial = author.trim().charAt(0).toUpperCase();
---
<div class="qcard">
  <div class="mark">&ldquo;</div>
  <p>{quote}</p>
  <div class="who">
    <div class="d">{initial}</div>
    <div><b>{author}</b><span>{context}</span></div>
  </div>
</div>

<style>
  .qcard{background:var(--paper);border:1px solid var(--cream-2);border-radius:18px;padding:32px 28px;height:100%}
  .mark{font-family:var(--serif);font-size:3.4rem;color:var(--gold-soft);line-height:.6;height:26px}
  p{font-family:var(--serif);font-style:italic;font-size:1.06rem;color:var(--ink);margin:6px 0 18px}
  .who{display:flex;align-items:center;gap:12px}
  .who .d{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#173d2e,#0e2a20);
    display:grid;place-items:center;color:var(--gold-2);font-family:var(--serif)}
  .who b{font-family:var(--sans);font-weight:500;font-size:.9rem;color:var(--green-800)}
  .who span{display:block;font-size:.74rem;color:var(--muted-2)}
</style>
