---
interface Props {
  bookHref?: string;
}
const { bookHref = '/contact' } = Astro.props;
const nav = [
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Testimonials', href: '/#quotes' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact' },
];
---
<header>
  <div class="wrap nav">
    <a class="brand" href="/">
      <img src="/logo.png" alt="Hannah's Hands" />
      <span class="bt">HANNAH'S HANDS<small>EVENTS COMPANY</small></span>
    </a>
    <nav class="menu">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <div class="nav-cta">
      <a href={bookHref} class="pill pill--gold">Book a Consultation</a>
    </div>
  </div>
</header>

<style>
  header{position:sticky;top:0;z-index:50;background:rgba(13,39,30,.92);backdrop-filter:blur(10px);
    border-bottom:1px solid rgba(217,184,119,.18)}
  .nav{display:flex;align-items:center;justify-content:space-between;height:76px}
  .brand{display:flex;align-items:center;gap:12px}
  .brand img{height:46px;width:auto;filter:drop-shadow(0 2px 6px rgba(0,0,0,.3))}
  .brand .bt{font-family:var(--serif);color:#f3ecdc;font-size:1.15rem;letter-spacing:.16em;line-height:1}
  .brand .bt small{display:block;font-size:.52rem;letter-spacing:.42em;color:var(--gold-2);margin-top:4px;font-family:var(--sans)}
  nav.menu{display:flex;gap:30px}
  nav.menu a{color:#e8e2d2;font-size:.82rem;letter-spacing:.06em;font-weight:300;position:relative;padding:4px 0}
  nav.menu a:hover{color:var(--gold-2)}
  nav.menu a::after{content:"";position:absolute;left:0;bottom:-2px;height:1px;width:0;background:var(--gold-2);transition:.25s}
  nav.menu a:hover::after{width:100%}
  @media(max-width:820px){ nav.menu{display:none} }
</style>
