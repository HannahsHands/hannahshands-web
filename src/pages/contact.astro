---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import { reader } from '../lib/reader';

const settings = (await reader.singletons.settings.read())!;
---
<Layout title="Contact — Hannah's Hands" description="Book a consultation with Hannah's Hands. Tell us about your event and we'll shape a bespoke plan.">
  <Header />

  <section class="phero">
    <div class="wrap">
      <span class="eyebrow">Let's Talk</span>
      <h1>Book a consultation</h1>
      <p>Tell us about your event and Olajumoke will personally shape a bespoke plan that
         fits your vision, your audience and your budget.</p>
    </div>
  </section>

  <ContactSection
    email={settings.email}
    instagram={settings.instagram}
    facebook={settings.facebook}
    heading="Send us the details"
  />

  {settings.calendlyUrl && (
    <section class="booking pad">
      <div class="wrap">
        <div class="sec-head">
          <span class="ornament">✦ OR BOOK DIRECTLY ✦</span>
          <h2>Pick a time that suits you</h2>
          <p>Prefer to skip the form? Grab a slot for a discovery call.</p>
        </div>
        <div class="calendly-inline-widget" data-url={settings.calendlyUrl} style="min-width:320px;height:660px;"></div>
        <p class="cal-fallback">Calendar not loading? <a href={settings.calendlyUrl} target="_blank" rel="noopener">Open the booking page in a new tab →</a></p>
      </div>
      <script is:inline async src="https://assets.calendly.com/assets/external/widget.js"></script>
    </section>
  )}

  <Footer email={settings.email} instagram={settings.instagram} facebook={settings.facebook} tagline={settings.tagline} />
</Layout>

<style>
  .phero{background:radial-gradient(120% 140% at 80% -10%,var(--green-700),var(--green-900) 62%);
    color:#f3ecdc;text-align:center;padding:84px 0 74px}
  .phero h1{font-size:clamp(2.3rem,4.6vw,3.6rem);color:#fbf6ea;margin:16px 0 14px}
  .phero p{color:#d6cfbe;max-width:56ch;margin:0 auto;font-size:1.05rem}

  .booking{background:var(--cream)}
  .booking .calendly-inline-widget{border-radius:18px;overflow:hidden;border:1px solid var(--cream-2)}
  .cal-fallback{text-align:center;font-size:.84rem;color:var(--muted-2);margin-top:16px}
  .cal-fallback a{color:var(--gold);text-decoration:underline}
</style>
