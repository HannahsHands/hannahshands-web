---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EventCard from '../../components/EventCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { reader, byOrder, CATEGORY_LABELS } from '../../lib/reader';

const events = byOrder(await reader.collections.events.all());
const settings = (await reader.singletons.settings.read())!;

// Only show filters for categories that actually have events.
const present = [...new Set(events.map((e) => e.entry.category))];
const filters = [
  { value: 'all', label: 'All' },
  ...present.map((c) => ({ value: c, label: CATEGORY_LABELS[c] ?? c })),
];
---
<Layout title="Portfolio — Hannah's Hands" description="Flagship conferences, galas, leadership summits and celebrations delivered by Hannah's Hands across the UK.">
  <Header />

  <section class="phero">
    <div class="wrap">
      <span class="eyebrow">Our Portfolio</span>
      <h1>Events we create</h1>
      <p>Trusted to deliver flagship conferences, galas and gatherings across the UK.</p>
    </div>
  </section>

  <section class="work pad">
    <div class="wrap">
      <div class="filters" role="tablist">
        {filters.map((f, i) => (
          <button class:list={['fbtn', { active: i === 0 }]} data-filter={f.value}>{f.label}</button>
        ))}
      </div>
      <div class="cat-grid" id="grid">
        {events.map((e) => (
          <EventCard
            slug={e.slug}
            title={e.entry.title}
            category={e.entry.category}
            coverImage={e.entry.coverImage}
            year={e.entry.year}
          />
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
  <Footer email={settings.email} instagram={settings.instagram} facebook={settings.facebook} tagline={settings.tagline} />
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.fbtn');
  const cards = document.querySelectorAll<HTMLElement>('#grid .cat');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      buttons.forEach((b) => b.classList.toggle('active', b === btn));
      cards.forEach((card) => {
        const show = filter === 'all' || card.dataset.category === filter;
        card.style.display = show ? '' : 'none';
      });
    });
  });
</script>

<style>
  .phero{background:radial-gradient(120% 140% at 80% -10%,var(--green-700),var(--green-900) 62%);
    color:#f3ecdc;text-align:center;padding:84px 0 74px}
  .phero h1{font-size:clamp(2.3rem,4.6vw,3.6rem);color:#fbf6ea;margin:16px 0 14px}
  .phero p{color:#d6cfbe;max-width:56ch;margin:0 auto;font-size:1.05rem}

  .work{background:var(--cream)}
  .filters{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:40px}
  .fbtn{font-family:var(--sans);font-size:.82rem;letter-spacing:.03em;padding:.6em 1.2em;border-radius:100px;
    border:1px solid var(--cream-2);background:var(--paper);color:var(--muted);cursor:pointer;transition:.2s}
  .fbtn:hover{border-color:var(--gold-soft);color:var(--green-800)}
  .fbtn.active{background:linear-gradient(135deg,var(--gold-2),var(--gold));color:#3a2c0e;border-color:transparent}
  .cat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  @media(max-width:900px){ .cat-grid{grid-template-columns:1fr 1fr} }
  @media(max-width:560px){ .cat-grid{grid-template-columns:1fr} }
</style>
