---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { reader, byOrder } from '../lib/reader';

const services = byOrder(await reader.collections.services.all());
const settings = (await reader.singletons.settings.read())!;
---
<Layout title="Services — Hannah's Hands" description="Corporate event planning, design and styling, venue sourcing, vendor and budget management — a full-service event partner.">
  <Header />

  <section class="phero">
    <div class="wrap">
      <span class="eyebrow">What We Do</span>
      <h1>A full-service event partner</h1>
      <p>From the first idea to the final thank-you, we handle every moving part so you can
         be present at your own event.</p>
    </div>
  </section>

  <section class="services pad">
    <div class="wrap">
      <div class="svc-grid">
        {services.map((s) => (
          <ServiceCard number={s.entry.number} title={s.entry.title} description={s.entry.description} />
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
  <Footer email={settings.email} instagram={settings.instagram} facebook={settings.facebook} tagline={settings.tagline} />
</Layout>

<style>
  .phero{background:radial-gradient(120% 140% at 80% -10%,var(--green-700),var(--green-900) 62%);
    color:#f3ecdc;text-align:center;padding:84px 0 74px}
  .phero h1{font-size:clamp(2.3rem,4.6vw,3.6rem);color:#fbf6ea;margin:16px 0 14px}
  .phero p{color:#d6cfbe;max-width:56ch;margin:0 auto;font-size:1.05rem}
  .services{background:var(--cream)}
  .svc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
  @media(max-width:900px){ .svc-grid{grid-template-columns:1fr 1fr} }
  @media(max-width:560px){ .svc-grid{grid-template-columns:1fr} }
</style>
